# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml must NEVER be committed to GitHub (Member D: add it to .gitignore).
# If secrets.toml is missing, the app falls back to sidebar text inputs
# so the prototype still runs on the leader's laptop without this file.

[mysql]
host = "localhost"
port = 3306
user = "root"
password = "your_mysql_password"
database = "portfolio_db"

# Only needed if you later wire up the Google Sheets data source too:
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "..."
# client_email = "..."
